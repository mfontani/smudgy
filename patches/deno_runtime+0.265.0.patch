+
+/// Per-parent worker quota. A permit is held by the worker thread itself, not
+/// by the host-side handle table: Node workers leave that table as soon as
+/// termination is requested, and Web Worker channels can close before their
+/// V8 isolate has finished unwinding.
+struct WorkerQuota {
+  max: usize,
+  live: Arc<AtomicUsize>,
+}
+
+impl WorkerQuota {
+  fn new(max: usize) -> Self {
+    Self {
+      max,
+      live: Arc::new(AtomicUsize::new(0)),
+    }
+  }
+
+  fn try_acquire(&self) -> Result<WorkerPermit, CreateWorkerError> {
+    self
+      .live
+      .fetch_update(Ordering::AcqRel, Ordering::Acquire, |live| {
+        (live < self.max).then_some(live + 1)
+      })
+      .map_err(|_| CreateWorkerError::Limit { max: self.max })?;
+    Ok(WorkerPermit {
+      live: Arc::clone(&self.live),
+    })
+  }
+}
+
+struct WorkerPermit {
+  live: Arc<AtomicUsize>,
+}
+
+impl Drop for WorkerPermit {
+  fn drop(&mut self) {
+    let previous = self.live.fetch_sub(1, Ordering::AcqRel);
+    debug_assert!(previous > 0, "worker quota permit underflow");
+  }
 }
 
