+
+#[cfg(test)]
+mod quota_tests {
+  use super::*;
+  use std::sync::Barrier;
+
+  #[test]
+  fn worker_quota_releases_only_when_permit_drops() {
+    let quota = WorkerQuota::new(1);
+    let permit = quota.try_acquire().expect("first worker gets the slot");
+    assert!(matches!(
+      quota.try_acquire(),
+      Err(CreateWorkerError::Limit { max: 1 })
+    ));
+    drop(permit);
+    assert!(quota.try_acquire().is_ok());
+  }
+
+  #[test]
+  fn worker_quota_tracks_thread_lifetime_and_unwind() {
+    let quota = WorkerQuota::new(1);
+    let permit = quota.try_acquire().expect("first worker gets the slot");
+    let barrier = Arc::new(Barrier::new(2));
+    let thread_barrier = Arc::clone(&barrier);
+    let handle = std::thread::spawn(move || {
+      let _permit = permit;
+      thread_barrier.wait();
+      thread_barrier.wait();
+    });
+    barrier.wait();
+    assert!(quota.try_acquire().is_err());
+    barrier.wait();
+    handle.join().expect("quota holder thread exits cleanly");
+    assert!(quota.try_acquire().is_ok());
+
+    let quota = WorkerQuota::new(1);
+    let _ = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+      let _permit = quota.try_acquire().expect("panic path gets a slot");
+      panic!("intentional quota unwind probe");
+    }));
+    assert!(quota.try_acquire().is_ok());
+  }
+}
