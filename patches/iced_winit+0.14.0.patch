@@ -0,0 +1,1033 @@
+use crate::core::window::Id;
+use crate::runtime::window::AnnouncementPriority;
+
+use accesskit::{
+    ActionHandler, ActionRequest, ActivationHandler, DeactivationHandler, Live, Node, NodeId, Role,
+    Tree, TreeId, TreeUpdate,
+};
+use accesskit_winit::Adapter;
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+#[cfg(target_os = "windows")]
+use std::mem;
+use std::rc::Rc;
+use std::sync::Arc;
+use std::sync::atomic::{AtomicU64, Ordering};
+use winit::event::WindowEvent;
+use winit::event_loop::ActiveEventLoop;
+use winit::window::{Window, WindowId};
+
+const ROOT_ID: NodeId = NodeId(0);
+const ANNOUNCEMENT_ID: NodeId = NodeId(1);
+const MAX_ANNOUNCEMENT_BYTES: usize = 4 * 1024;
+
+pub(crate) type SharedManager = Rc<RefCell<Manager>>;
+
+pub(crate) fn shared_manager() -> SharedManager {
+    Rc::new(RefCell::new(Manager::default()))
+}
+
+fn live_region(text: &str, live: Live) -> Node {
+    let mut node = Node::new(Role::Label);
+    node.set_value(text);
+    node.set_live(live);
+    node
+}
+
+fn initial_tree() -> TreeUpdate {
+    let mut root = Node::new(Role::Window);
+    root.set_children(vec![ANNOUNCEMENT_ID]);
+
+    TreeUpdate {
+        nodes: vec![
+            (ROOT_ID, root),
+            (ANNOUNCEMENT_ID, live_region("", Live::Off)),
+        ],
+        tree: Some(Tree::new(ROOT_ID)),
+        tree_id: TreeId::ROOT,
+        focus: ROOT_ID,
+    }
+}
+
+fn announcement_update(text: &str, live: Live) -> TreeUpdate {
+    TreeUpdate {
+        nodes: vec![(ANNOUNCEMENT_ID, live_region(text, live))],
+        tree: None,
+        tree_id: TreeId::ROOT,
+        focus: ROOT_ID,
+    }
+}
+
+#[derive(Default)]
+struct Lifecycle {
+    // Zero is preactivation, odd values are active generations, and nonzero
+    // even values are inactive generations. One atomic prevents torn
+    // active/epoch observations across AccessKit callbacks and the event loop.
+    state: AtomicU64,
+}
+
+impl Lifecycle {
+    fn activate(&self) {
+        let _ = self
+            .state
+            .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |state| {
+                state.is_multiple_of(2).then(|| {
+                    state
+                        .checked_add(1)
+                        .expect("accessibility lifecycle exhausted")
+                })
+            });
+    }
+
+    fn deactivate(&self) {
+        let _ = self
+            .state
+            .fetch_update(Ordering::SeqCst, Ordering::SeqCst, |state| {
+                (!state.is_multiple_of(2)).then(|| {
+                    state
+                        .checked_add(1)
+                        .expect("accessibility lifecycle exhausted")
+                })
+            });
+    }
+
+    fn snapshot(&self) -> u64 {
+        self.state.load(Ordering::SeqCst)
+    }
+}
+
+struct InitialTreeHandler(Arc<Lifecycle>);
+
+impl ActivationHandler for InitialTreeHandler {
+    fn request_initial_tree(&mut self) -> Option<TreeUpdate> {
+        self.0.activate();
+        Some(initial_tree())
+    }
+}
+
+struct IgnoreActions;
+
+impl ActionHandler for IgnoreActions {
+    fn do_action(&mut self, _request: ActionRequest) {}
+}
+
+struct DeactivateHandler(Arc<Lifecycle>);
+
+impl DeactivationHandler for DeactivateHandler {
+    fn deactivate_accessibility(&mut self) {
+        self.0.deactivate();
+    }
+}
+
+trait TreeAdapter {
+    fn update_if_active(&mut self, update: TreeUpdate) -> bool;
+}
+
+struct NativeAdapter<A> {
+    inner: Option<A>,
+}
+
+impl<A> NativeAdapter<A> {
+    fn new(adapter: A) -> Self {
+        Self {
+            inner: Some(adapter),
+        }
+    }
+
+    fn get_mut(&mut self) -> Option<&mut A> {
+        self.inner.as_mut()
+    }
+
+    fn drop_after_native_destroy(mut self) {
+        drop(self.inner.take());
+    }
+}
+
+#[cfg(target_os = "windows")]
+impl<A> Drop for NativeAdapter<A> {
+    fn drop(&mut self) {
+        if let Some(adapter) = self.inner.take() {
+            // A remaining adapter has no observed native-destruction barrier.
+            // Retaining it until process reclamation is safer than uninstalling
+            // its WNDPROC ahead of later common-controls subclasses.
+            mem::forget(adapter);
+        }
+    }
+}
+
+struct PlatformAdapter {
+    inner: NativeAdapter<Adapter>,
+}
+
+impl PlatformAdapter {
+    fn new(event_loop: &ActiveEventLoop, window: &Window, lifecycle: &Arc<Lifecycle>) -> Self {
+        Self {
+            inner: NativeAdapter::new(Adapter::with_direct_handlers(
+                event_loop,
+                window,
+                InitialTreeHandler(Arc::clone(lifecycle)),
+                IgnoreActions,
+                DeactivateHandler(Arc::clone(lifecycle)),
+            )),
+        }
+    }
+
+    fn process_event(&mut self, window: &Window, event: &WindowEvent) {
+        if let Some(adapter) = self.inner.get_mut() {
+            adapter.process_event(window, event);
+        }
+    }
+
+    fn drop_after_native_destroy(self) {
+        self.inner.drop_after_native_destroy();
+    }
+}
+
+impl TreeAdapter for PlatformAdapter {
+    fn update_if_active(&mut self, update: TreeUpdate) -> bool {
+        let Some(adapter) = self.inner.get_mut() else {
+            return false;
+        };
+        let mut applied = false;
+
+        adapter.update_if_active(|| {
+            applied = true;
+            update
+        });
+
+        applied
+    }
+}
+
+struct Pending {
+    text: String,
+    priority: AnnouncementPriority,
+    target_state: u64,
+}
+
+struct Bridge<A> {
+    adapter: Option<A>,
+    lifecycle: Arc<Lifecycle>,
+    pending: Option<Pending>,
+}
+
+impl<A: TreeAdapter> Bridge<A> {
+    fn with_adapter(adapter: A, lifecycle: Arc<Lifecycle>) -> Self {
+        Self {
+            adapter: Some(adapter),
+            lifecycle,
+            pending: None,
+        }
+    }
+
+    fn queue(&mut self, text: String, priority: AnnouncementPriority) -> bool {
+        if text.is_empty() || text.len() > MAX_ANNOUNCEMENT_BYTES {
+            return false;
+        }
+        let state = self.lifecycle.snapshot();
+
+        let target_state = if state == 0 {
+            1
+        } else if !state.is_multiple_of(2) {
+            state
+        } else {
+            self.pending = None;
+            return false;
+        };
+
+        self.pending = Some(Pending {
+            text,
+            priority,
+            target_state,
+        });
+        true
+    }
+
+    fn clear(&mut self) {
+        self.pending = None;
+    }
+
+    fn flush(&mut self) {
+        let Some(pending) = self.pending.as_ref() else {
+            return;
+        };
+        let state = self.lifecycle.snapshot();
+
+        if state == 0 {
+            return;
+        }
+        if pending.target_state != state {
+            self.pending = None;
+            return;
+        }
+        let pending = self
+            .pending
+            .take()
+            .expect("pending announcement still present");
+
+        let Some(adapter) = self.adapter.as_mut() else {
+            return;
+        };
+
+        let _ = adapter.update_if_active(announcement_update("", Live::Off));
+        let live = match pending.priority {
+            AnnouncementPriority::Polite => Live::Polite,
+            AnnouncementPriority::Assertive => Live::Assertive,
+        };
+        let _ = adapter.update_if_active(announcement_update(&pending.text, live));
+    }
+}
+
+impl Bridge<PlatformAdapter> {
+    fn new(event_loop: &ActiveEventLoop, window: &Window) -> Self {
+        let lifecycle = Arc::new(Lifecycle::default());
+        let adapter = PlatformAdapter::new(event_loop, window, &lifecycle);
+        Self::with_adapter(adapter, lifecycle)
+    }
+
+    fn process_event(&mut self, window: &Window, event: &WindowEvent) {
+        if let Some(adapter) = self.adapter.as_mut() {
+            adapter.process_event(window, event);
+        }
+    }
+
+    fn drop_after_native_destroy(mut self) {
+        if let Some(adapter) = self.adapter.take() {
+            adapter.drop_after_native_destroy();
+        }
+    }
+}
+
+struct LiveWindow {
+    raw: Arc<Window>,
+    bridge: Bridge<PlatformAdapter>,
+}
+
+struct Retired<B> {
+    bridge: B,
+    destroyed_seen: bool,
+}
+
+struct Routing<K, L, B> {
+    aliases: BTreeMap<Id, K>,
+    live: BTreeMap<K, (Id, L)>,
+    retired: BTreeMap<K, Retired<B>>,
+}
+
+impl<K: Copy + Ord, L, B> Default for Routing<K, L, B> {
+    fn default() -> Self {
+        Self {
+            aliases: BTreeMap::new(),
+            live: BTreeMap::new(),
+            retired: BTreeMap::new(),
+        }
+    }
+}
+
+impl<K: Copy + Ord, L, B> Routing<K, L, B> {
+    fn insert(&mut self, id: Id, key: K, live: L) {
+        assert!(!self.aliases.contains_key(&id));
+        assert!(!self.live.contains_key(&key));
+        let _ = self.aliases.insert(id, key);
+        let _ = self.live.insert(key, (id, live));
+    }
+
+    fn live_mut(&mut self, key: K) -> Option<&mut L> {
+        self.live.get_mut(&key).map(|(_, live)| live)
+    }
+
+    fn live_mut_by_id(&mut self, id: Id) -> Option<&mut L> {
+        let key = self.aliases.get(&id).copied()?;
+        self.live_mut(key)
+    }
+
+    fn take_live_by_key(&mut self, key: K) -> Option<L> {
+        let (id, live) = self.live.remove(&key)?;
+        let _ = self.aliases.remove(&id);
+        Some(live)
+    }
+
+    fn take_live_by_id(&mut self, id: Id, expected_key: K) -> Option<L> {
+        let key = self.aliases.get(&id).copied()?;
+        if key != expected_key {
+            return None;
+        }
+
+        self.take_live_by_key(key)
+    }
+
+    fn add_retired(&mut self, key: K, bridge: B, destroyed_seen: bool) {
+        assert!(!self.retired.contains_key(&key));
+        let _ = self.retired.insert(
+            key,
+            Retired {
+                bridge,
+                destroyed_seen,
+            },
+        );
+    }
+
+    fn mark_destroyed(&mut self, key: K) -> bool {
+        if let Some(window) = self.retired.get_mut(&key) {
+            window.destroyed_seen = true;
+            true
+        } else {
+            false
+        }
+    }
+
+    fn take_reused_destroyed(&mut self, key: K) -> Result<Option<B>, ()> {
+        let Some(retired) = self.retired.remove(&key) else {
+            return Ok(None);
+        };
+
+        if retired.destroyed_seen {
+            Ok(Some(retired.bridge))
+        } else {
+            let _ = self.retired.insert(key, retired);
+            Err(())
+        }
+    }
+
+    fn take_destroyed(&mut self) -> Vec<B> {
+        let destroyed = self
+            .retired
+            .iter()
+            .filter_map(|(key, window)| window.destroyed_seen.then_some(*key))
+            .collect::<Vec<_>>();
+
+        destroyed
+            .into_iter()
+            .filter_map(|key| self.retired.remove(&key).map(|window| window.bridge))
+            .collect()
+    }
+}
+
+#[derive(Default)]
+pub(crate) struct Manager {
+    routing: Routing<WindowId, LiveWindow, Bridge<PlatformAdapter>>,
+}
+
+impl Manager {
+    pub(crate) fn insert(&mut self, event_loop: &ActiveEventLoop, id: Id, raw: Arc<Window>) {
+        let window_id = raw.id();
+        if let Some(bridge) = self
+            .routing
+            .take_reused_destroyed(window_id)
+            .expect("native window id reused before destruction was observed")
+        {
+            bridge.drop_after_native_destroy();
+        }
+        let bridge = Bridge::new(event_loop, &raw);
+
+        self.routing
+            .insert(id, window_id, LiveWindow { raw, bridge });
+    }
+
+    pub(crate) fn process_window_event(&mut self, window_id: WindowId, event: &WindowEvent) {
+        if matches!(event, WindowEvent::Destroyed) && self.routing.mark_destroyed(window_id) {
+            return;
+        }
+
+        if let Some(window) = self.routing.live_mut(window_id) {
+            window.bridge.process_event(&window.raw, event);
+
+            if matches!(event, WindowEvent::Destroyed) {
+                let mut window = self
+                    .routing
+                    .take_live_by_key(window_id)
+                    .expect("live window still present");
+                window.bridge.clear();
+                let LiveWindow { raw, bridge } = window;
+
+                drop(raw);
+                self.routing.add_retired(window_id, bridge, true);
+            }
+
+            return;
+        }
+    }
+
+    pub(crate) fn retire(&mut self, id: Id, expected_window_id: WindowId) {
+        let Some(mut window) = self.routing.take_live_by_id(id, expected_window_id) else {
+            return;
+        };
+
+        window.bridge.clear();
+        let LiveWindow { raw, bridge } = window;
+        self.routing.add_retired(expected_window_id, bridge, false);
+        drop(raw);
+    }
+
+    pub(crate) fn queue(&mut self, id: Id, text: String, priority: AnnouncementPriority) {
+        let Some(window) = self.routing.live_mut_by_id(id) else {
+            return;
+        };
+
+        let _ = window.bridge.queue(text, priority);
+    }
+
+    pub(crate) fn flush(&mut self) {
+        for (_, window) in self.routing.live.values_mut() {
+            window.bridge.flush();
+        }
+    }
+
+    pub(crate) fn drain_destroyed(&mut self) {
+        for bridge in self.routing.take_destroyed() {
+            bridge.drop_after_native_destroy();
+        }
+    }
+}
+
+impl Drop for Manager {
+    fn drop(&mut self) {
+        self.drain_destroyed();
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[derive(Default)]
+    struct RecordingAdapter {
+        active: bool,
+        updates: Vec<TreeUpdate>,
+    }
+
+    impl TreeAdapter for RecordingAdapter {
+        fn update_if_active(&mut self, update: TreeUpdate) -> bool {
+            if self.active {
+                self.updates.push(update);
+                true
+            } else {
+                false
+            }
+        }
+    }
+
+    fn active_bridge() -> Bridge<RecordingAdapter> {
+        let lifecycle = Arc::new(Lifecycle::default());
+        lifecycle.activate();
+        Bridge::with_adapter(
+            RecordingAdapter {
+                active: true,
+                updates: Vec::new(),
+            },
+            lifecycle,
+        )
+    }
+
+    fn node(update: &TreeUpdate) -> &Node {
+        &update.nodes[0].1
+    }
+
+    #[test]
+    fn initial_tree_has_only_stable_root_and_live_region_nodes() {
+        let update = initial_tree();
+
+        assert_eq!(update.nodes.len(), 2);
+        assert_eq!(update.nodes[0].0, ROOT_ID);
+        assert_eq!(update.nodes[0].1.role(), Role::Window);
+        assert_eq!(update.nodes[0].1.children(), &[ANNOUNCEMENT_ID]);
+        assert_eq!(update.nodes[1].0, ANNOUNCEMENT_ID);
+        assert_eq!(update.nodes[1].1.role(), Role::Label);
+        assert_eq!(update.nodes[1].1.value(), Some(""));
+        assert_eq!(update.nodes[1].1.live(), Some(Live::Off));
+        assert_eq!(update.tree, Some(Tree::new(ROOT_ID)));
+        assert_eq!(update.focus, ROOT_ID);
+    }
+
+    #[test]
+    fn valid_requests_coalesce_per_window_and_invalid_requests_are_ignored() {
+        let mut bridge = active_bridge();
+
+        assert!(bridge.queue("first".into(), AnnouncementPriority::Polite));
+        assert!(!bridge.queue(String::new(), AnnouncementPriority::Assertive));
+        assert!(!bridge.queue(
+            "x".repeat(MAX_ANNOUNCEMENT_BYTES + 1),
+            AnnouncementPriority::Assertive,
+        ));
+        assert!(bridge.queue(
+            "é".repeat(MAX_ANNOUNCEMENT_BYTES / 2),
+            AnnouncementPriority::Assertive,
+        ));
+        bridge.flush();
+
+        let adapter = bridge.adapter.as_ref().unwrap();
+        assert_eq!(adapter.updates.len(), 2);
+        assert_eq!(node(&adapter.updates[0]).value(), Some(""));
+        assert_eq!(node(&adapter.updates[0]).live(), Some(Live::Off));
+        assert_eq!(
+            node(&adapter.updates[1]).value(),
+            Some("é".repeat(MAX_ANNOUNCEMENT_BYTES / 2).as_str())
+        );
+        assert_eq!(node(&adapter.updates[1]).live(), Some(Live::Assertive));
+    }
+
+    #[test]
+    fn identical_text_always_uses_an_off_then_requested_live_sequence() {
+        let mut bridge = active_bridge();
+
+        for _ in 0..2 {
+            assert!(bridge.queue("same".into(), AnnouncementPriority::Polite));
+            bridge.flush();
+        }
+
+        let adapter = bridge.adapter.as_ref().unwrap();
+        assert_eq!(adapter.updates.len(), 4);
+        for pair in adapter.updates.chunks_exact(2) {
+            assert_eq!(node(&pair[0]).value(), Some(""));
+            assert_eq!(node(&pair[0]).live(), Some(Live::Off));
+            assert_eq!(node(&pair[1]).value(), Some("same"));
+            assert_eq!(node(&pair[1]).live(), Some(Live::Polite));
+        }
+    }
+
+    #[test]
+    fn lifecycle_state_transitions_are_atomic_and_idempotent() {
+        let lifecycle = Lifecycle::default();
+        assert_eq!(lifecycle.snapshot(), 0);
+        lifecycle.activate();
+        assert_eq!(lifecycle.snapshot(), 1);
+        lifecycle.activate();
+        assert_eq!(lifecycle.snapshot(), 1);
+        lifecycle.deactivate();
+        assert_eq!(lifecycle.snapshot(), 2);
+        lifecycle.deactivate();
+        assert_eq!(lifecycle.snapshot(), 2);
+        lifecycle.activate();
+        assert_eq!(lifecycle.snapshot(), 3);
+    }
+
+    #[test]
+    fn preactivation_announcements_coalesce_and_deliver_after_first_activation() {
+        let lifecycle = Arc::new(Lifecycle::default());
+        let mut bridge = Bridge::with_adapter(
+            RecordingAdapter {
+                active: true,
+                updates: Vec::new(),
+            },
+            Arc::clone(&lifecycle),
+        );
+
+        assert!(bridge.queue("startup-old".into(), AnnouncementPriority::Polite));
+        assert!(bridge.queue("startup-new".into(), AnnouncementPriority::Assertive));
+        bridge.flush();
+        assert!(bridge.pending.is_some());
+        assert!(bridge.adapter.as_ref().unwrap().updates.is_empty());
+
+        // Native accessibility processing runs before iced dispatch, and the
+        // manager flushes at AboutToWait, so this is the production ordering.
+        lifecycle.activate();
+        bridge.flush();
+        assert!(bridge.pending.is_none());
+        let adapter = bridge.adapter.as_ref().unwrap();
+        assert_eq!(adapter.updates.len(), 2);
+        assert_eq!(node(&adapter.updates[1]).value(), Some("startup-new"));
+        assert_eq!(node(&adapter.updates[1]).live(), Some(Live::Assertive));
+    }
+
+    #[test]
+    fn preactivation_clear_prevents_closed_window_replay() {
+        let lifecycle = Arc::new(Lifecycle::default());
+        let mut bridge = Bridge::with_adapter(
+            RecordingAdapter {
+                active: true,
+                updates: Vec::new(),
+            },
+            Arc::clone(&lifecycle),
+        );
+
+        assert!(bridge.queue("closed".into(), AnnouncementPriority::Assertive));
+        bridge.clear();
+        lifecycle.activate();
+        bridge.flush();
+
+        assert!(bridge.pending.is_none());
+        assert!(bridge.adapter.as_ref().unwrap().updates.is_empty());
+    }
+
+    #[test]
+    fn inactive_and_lifecycle_edges_drop_without_replay() {
+        let lifecycle = Arc::new(Lifecycle::default());
+        lifecycle.activate();
+        let mut bridge = Bridge::with_adapter(
+            RecordingAdapter {
+                active: true,
+                updates: Vec::new(),
+            },
+            Arc::clone(&lifecycle),
+        );
+        assert!(bridge.queue("stale".into(), AnnouncementPriority::Assertive));
+
+        lifecycle.deactivate();
+        lifecycle.activate();
+        bridge.flush();
+        assert!(bridge.adapter.as_ref().unwrap().updates.is_empty());
+
+        lifecycle.deactivate();
+        assert!(!bridge.queue("inactive".into(), AnnouncementPriority::Polite));
+        lifecycle.activate();
+        bridge.flush();
+        assert!(bridge.adapter.as_ref().unwrap().updates.is_empty());
+    }
+
+    #[test]
+    fn injected_inactive_lifecycle_and_inert_adapter_drop_without_replay() {
+        let lifecycle = Arc::new(Lifecycle::default());
+        lifecycle.activate();
+        lifecycle.deactivate();
+        let mut bridge = Bridge::with_adapter(
+            RecordingAdapter {
+                active: false,
+                updates: Vec::new(),
+            },
+            Arc::clone(&lifecycle),
+        );
+
+        assert!(!bridge.queue("inactive".into(), AnnouncementPriority::Polite));
+        lifecycle.activate();
+        bridge.flush();
+        assert!(bridge.pending.is_none());
+
+        assert!(bridge.queue("unsupported".into(), AnnouncementPriority::Assertive));
+        bridge.flush();
+        bridge.adapter.as_mut().unwrap().active = true;
+        bridge.flush();
+        assert!(bridge.adapter.as_ref().unwrap().updates.is_empty());
+    }
+
+    #[test]
+    fn two_windows_coalesce_and_flush_independently() {
+        let mut first = active_bridge();
+        let mut second = active_bridge();
+
+        assert!(first.queue("first-old".into(), AnnouncementPriority::Polite));
+        assert!(second.queue("second".into(), AnnouncementPriority::Assertive));
+        assert!(first.queue("first-new".into(), AnnouncementPriority::Assertive));
+
+        first.flush();
+        assert_eq!(first.adapter.as_ref().unwrap().updates.len(), 2);
+        assert_eq!(second.adapter.as_ref().unwrap().updates.len(), 0);
+        assert_eq!(
+            node(&first.adapter.as_ref().unwrap().updates[1]).value(),
+            Some("first-new")
+        );
+
+        second.flush();
+        assert_eq!(second.adapter.as_ref().unwrap().updates.len(), 2);
+        assert_eq!(
+            node(&second.adapter.as_ref().unwrap().updates[1]).value(),
+            Some("second")
+        );
+    }
