+    #[test]
+    fn close_and_destroyed_barrier_preserve_native_teardown_order() {
+        let log = Rc::new(RefCell::new(Vec::new()));
+        let id = Id::unique();
+        let mut routing = Routing::<u8, ModelLive, DropProbe>::default();
+        routing.insert(
+            id,
+            1,
+            ModelLive {
+                manager_raw: probe("manager-raw-drop", &log),
+                iced_raw: probe("iced-raw-drop", &log),
+                surface: probe("surface-drop", &log),
+                adapter: probe("adapter-drop", &log),
+            },
+        );
+
+        let live = routing.take_live_by_id(id, 1).unwrap();
+        let ModelLive {
+            manager_raw,
+            iced_raw,
+            surface,
+            adapter,
+        } = live;
+        routing.add_retired(1, adapter, false);
+        drop(manager_raw);
+        drop(iced_raw);
+        drop(surface);
+
+        log.borrow_mut().push("wm-destroy");
+        log.borrow_mut().push("destroyed-callback");
+        assert!(routing.mark_destroyed(1));
+        assert!(!log.borrow().contains(&"adapter-drop"));
+        log.borrow_mut().push("callback-return");
+        log.borrow_mut().push("wm-ncdestroy");
+        log.borrow_mut().push("real-boundary");
+        for adapter in routing.take_destroyed() {
+            drop(adapter);
+        }
+
+        assert_eq!(
+            log.borrow().as_slice(),
+            [
+                "manager-raw-drop",
+                "iced-raw-drop",
+                "surface-drop",
+                "wm-destroy",
+                "destroyed-callback",
+                "callback-return",
+                "wm-ncdestroy",
+                "real-boundary",
+                "adapter-drop",
+            ]
+        );
+        assert!(routing.retired.is_empty());
+    }
