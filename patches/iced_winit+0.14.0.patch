+
+    impl Drop for DropProbe {
+        fn drop(&mut self) {
+            self.log.borrow_mut().push(self.name);
+        }
+    }
+
+    struct ModelLive {
+        manager_raw: DropProbe,
+        iced_raw: DropProbe,
+        surface: DropProbe,
+        adapter: DropProbe,
+    }
+
+    fn probe(name: &'static str, log: &Rc<RefCell<Vec<&'static str>>>) -> DropProbe {
+        DropProbe {
+            name,
+            log: Rc::clone(log),
+        }
+    }
