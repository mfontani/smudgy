+    #[test]
+    fn external_live_destroyed_forwards_first_then_becomes_stale_and_seen() {
+        let log = Rc::new(RefCell::new(Vec::new()));
+        let id = Id::unique();
+        let mut routing = Routing::<u8, ModelLive, DropProbe>::default();
+        routing.insert(
+            id,
+            7,
+            ModelLive {
+                manager_raw: probe("manager-raw-drop", &log),
+                iced_raw: probe("iced-raw-drop", &log),
+                surface: probe("surface-drop", &log),
+                adapter: probe("adapter-drop", &log),
+            },
+        );
+
+        log.borrow_mut().push("adapter-process-event");
+        let live = routing.take_live_by_key(7).unwrap();
+        let ModelLive {
+            manager_raw,
+            iced_raw,
+            surface,
+            adapter,
+        } = live;
+        routing.add_retired(7, adapter, true);
+        drop(manager_raw);
+        log.borrow_mut().push("iced-process-event");
+
+        assert!(routing.live_mut_by_id(id).is_none());
+        assert!(routing.retired.get(&7).unwrap().destroyed_seen);
+        assert_eq!(log.borrow()[0], "adapter-process-event");
+        assert_eq!(log.borrow()[2], "iced-process-event");
+        assert!(!log.borrow().contains(&"adapter-drop"));
+
+        drop(iced_raw);
+        drop(surface);
+        for adapter in routing.take_destroyed() {
+            drop(adapter);
+        }
+        assert!(log.borrow().contains(&"adapter-drop"));
+    }
+
+    #[test]
+    fn reused_native_id_drains_seen_retirement_before_new_registration() {
+        let log = Rc::new(RefCell::new(Vec::new()));
+        let mut routing = Routing::<u8, (), DropProbe>::default();
+        routing.add_retired(3, probe("old-adapter-drop", &log), true);
+
+        let old = routing
+            .take_reused_destroyed(3)
+            .expect("seen native id is reusable")
+            .expect("old adapter is drained");
+        drop(old);
+        routing.insert(Id::unique(), 3, ());
+
+        assert_eq!(log.borrow().as_slice(), ["old-adapter-drop"]);
+        assert!(routing.retired.is_empty());
+
+        routing.add_retired(4, probe("unseen-adapter", &log), false);
+        assert!(routing.take_reused_destroyed(4).is_err());
+        assert!(routing.retired.contains_key(&4));
+        assert_eq!(log.borrow().as_slice(), ["old-adapter-drop"]);
+    }
+
+    struct ExitBridge {
+        adapter: Option<DropProbe>,
+        _pending: Option<DropProbe>,
+        retained: Rc<RefCell<usize>>,
+    }
+
+    impl ExitBridge {
+        fn drop_after_native_destroy(mut self) {
+            drop(self.adapter.take());
+        }
+    }
+
+    impl Drop for ExitBridge {
+        fn drop(&mut self) {
+            #[cfg(target_os = "windows")]
+            if let Some(adapter) = self.adapter.take() {
+                *self.retained.borrow_mut() += 1;
+                mem::forget(adapter);
+            }
+        }
+    }
+
+    struct ExitLive {
+        _raw: DropProbe,
+        _bridge: ExitBridge,
+    }
+
+    struct ExitManager {
+        routing: Routing<u8, ExitLive, ExitBridge>,
+    }
+
+    impl Drop for ExitManager {
+        fn drop(&mut self) {
+            for bridge in self.routing.take_destroyed() {
+                bridge.drop_after_native_destroy();
+            }
+        }
+    }
+
+    fn exit_bridge(
+        adapter: &'static str,
+        pending: &'static str,
+        log: &Rc<RefCell<Vec<&'static str>>>,
+        retained: &Rc<RefCell<usize>>,
+    ) -> ExitBridge {
+        ExitBridge {
+            adapter: Some(probe(adapter, log)),
+            _pending: Some(probe(pending, log)),
+            retained: Rc::clone(retained),
+        }
+    }
+
+    #[test]
+    fn panic_unwind_without_later_boundary_drops_seen_and_bounds_unseen_retention() {
+        let log = Rc::new(RefCell::new(Vec::new()));
+        let retained = Rc::new(RefCell::new(0));
+        let result = std::panic::catch_unwind(std::panic::AssertUnwindSafe(|| {
+            let mut routing = Routing::<u8, ExitLive, ExitBridge>::default();
+            routing.add_retired(
+                1,
+                exit_bridge("seen-adapter", "seen-pending", &log, &retained),
+                true,
+            );
+            routing.add_retired(
+                2,
+                exit_bridge("unseen-adapter", "unseen-pending", &log, &retained),
+                false,
+            );
+            routing.insert(
+                Id::unique(),
+                3,
+                ExitLive {
+                    _raw: probe("live-raw", &log),
+                    _bridge: exit_bridge("live-adapter", "live-pending", &log, &retained),
+                },
+            );
+            let _manager = ExitManager { routing };
+
+            panic!("callback panic after the final native event");
+        }));
+
+        assert!(result.is_err());
+        let log = log.borrow();
+        assert!(log.contains(&"seen-adapter"));
+        assert!(log.contains(&"seen-pending"));
+        assert!(log.contains(&"unseen-pending"));
+        assert!(log.contains(&"live-pending"));
+        assert!(log.contains(&"live-raw"));
+
+        #[cfg(target_os = "windows")]
+        {
+            assert!(!log.contains(&"unseen-adapter"));
+            assert!(!log.contains(&"live-adapter"));
+            assert_eq!(*retained.borrow(), 2);
+        }
+
+        #[cfg(not(target_os = "windows"))]
+        {
+            assert!(log.contains(&"unseen-adapter"));
+            assert!(log.contains(&"live-adapter"));
+            assert_eq!(*retained.borrow(), 0);
+        }
+    }
+
+    #[cfg(target_os = "windows")]
+    #[test]
+    fn last_window_exit_drops_seen_and_forgets_only_unseen_adapters() {
+        let log = Rc::new(RefCell::new(Vec::new()));
+
+        NativeAdapter::new(probe("destroyed-seen", &log)).drop_after_native_destroy();
+        drop(NativeAdapter::new(probe("retired-not-seen", &log)));
+        drop(NativeAdapter::new(probe("still-live", &log)));
+
+        assert_eq!(log.borrow().as_slice(), ["destroyed-seen"]);
+    }
+}
