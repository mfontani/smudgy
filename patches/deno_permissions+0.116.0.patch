+  #[test]
+  fn test_windows_pipe_namespace_predicate() {
+    // Byte-level predicate, so the pipe-namespace shapes hold on every host
+    // platform. Every accepted spelling combines either separator with the
+    // `.` or `?` namespace marker and a case-insensitive `pipe` segment that
+    // is followed by a separator.
+    for path in [
+      r"\\.\pipe\x",
+      r"\\.\PIPE\deno-ipc",
+      r"\\?\pipe\x",
+      "//./pipe/x",
+      r"\\./pipe/x",
+      r"//?/pipe\x",
+    ] {
+      assert!(is_windows_pipe_namespace_path(Path::new(path)), "{path}");
+    }
+    // Everything else in (or out of) the device namespace stays unmatched:
+    // other devices, drive paths, the bare pipe root without a separator,
+    // and names that merely begin with "pipe".
+    for path in [
+      r"\\.\CON",
+      r"\\.\PhysicalDrive0",
+      r"\\.\C:",
+      r"\\.\pipe",
+      r"\\.\pipefitting\x",
+      r"\\.\pip\x",
+      r"C:\pipe\x",
+      r"\pipe\x",
+      "/dev/pipe/x",
+      "pipe/x",
+    ] {
+      assert!(!is_windows_pipe_namespace_path(Path::new(path)), "{path}");
+    }
+  }
