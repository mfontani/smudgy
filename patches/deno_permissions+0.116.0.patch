+  #[test]
+  fn test_wildcard_never_parses_to_any_host_for_query() {
+    // `Host::Any` may only ever be produced by allow-list parsing
+    // (`SubdomainWildcards::Enabled`). Query-side parsing runs with wildcards
+    // disabled, so a literal "*" hostname arriving from a remote peer (e.g. a
+    // redirect or a hostile URL) is an ordinary invalid host name. If query
+    // parsing ever produced `Host::Any`, that single request would match every
+    // allow-list entry.
+    assert_eq!(Host::parse_for_query("*").ok(), None);
+    assert_eq!(NetDescriptor::parse_for_query("*").ok(), None);
+    assert_eq!(NetDescriptor::parse_for_query("*:443").ok(), None);
+    for input in ["*", "*:443", "*.deno.land", "*.deno.land:443"] {
+      let parsed = NetDescriptor::parse_for_query(input);
+      assert!(
+        !matches!(parsed, Ok(NetDescriptor(Host::Any, _))),
+        "query-parse of {input:?} must never yield Host::Any: {parsed:?}"
+      );
+    }
+  }
