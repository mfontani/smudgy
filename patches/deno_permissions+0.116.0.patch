+  fn test_scoped_grants_admit_pipe_namespace_paths_without_all() {
+    set_prompter(Box::new(TestPrompter));
+    let parser = TestPermissionDescriptorParser;
+    let perms = Permissions::from_options(
+      &parser,
+      &PermissionsOptions {
+        allow_read: Some(svec![r"\\.\pipe\x", "//./pipe/x"]),
+        allow_write: Some(svec![r"\\.\pipe\x", "//./pipe/x"]),
+        prompt: false,
+        ..Default::default()
+      },
+    )
+    .unwrap();
+    let perms = PermissionsContainer::new(Arc::new(parser), perms);
+
+    // Exact scoped read+write grants -- with no unscoped "all" permission --
+    // admit the canonical backslash spelling of the granted pipe.
+    assert!(
+      perms
+        .check_open(
+          Cow::Borrowed(Path::new(r"\\.\pipe\x")),
+          OpenAccessKind::ReadWrite,
+          None,
+        )
+        .is_ok()
+    );
+    // The forward-slash spelling of the same object is equally admitted; the
+    // boundary is the pipe itself, not its spelling.
+    assert!(
+      perms
+        .check_open(
+          Cow::Borrowed(Path::new("//./pipe/x")),
+          OpenAccessKind::ReadWrite,
+          None,
+        )
+        .is_ok()
+    );
+    // A different pipe name stays denied by the ordinary scoped path checks:
+    // the carve-out removes the all-permissions wall, it grants nothing.
+    let err = perms
+      .check_open(
+        Cow::Borrowed(Path::new(r"\\.\pipe\other")),
+        OpenAccessKind::ReadWrite,
+        None,
+      )
+      .unwrap_err();
+    assert!(
+      err.to_string().contains("read access"),
+      "an ungranted pipe must fail the scoped read check: {err}"
+    );
+  }
