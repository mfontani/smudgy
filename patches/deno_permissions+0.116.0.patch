+/// Whether a path names an object inside the Windows named-pipe namespace.
+///
+/// Matches every spelling that can reach `check_special_file`: the `\\.\pipe\`
+/// device form (device paths pass through path parsing and canonicalization
+/// unmodified), the `//./pipe/` forward-slash spelling (not recognized as a
+/// device path, so it arrives with either separator preserved), and the
+/// `\\?\pipe\` verbatim form (verbatim-prefix stripping only rewrites drive
+/// paths, so it survives intact). The `pipe` segment is compared
+/// case-insensitively to match the NT object namespace. Only the pipe
+/// namespace qualifies: every other device-namespace object (`\\.\CON`,
+/// `\\.\PhysicalDrive0`, `\\.\C:`, ...) is a device-level capability and must
+/// keep requiring all permissions.
+fn is_windows_pipe_namespace_path(path: &Path) -> bool {
+  fn is_sep(b: u8) -> bool {
+    b == b'\\' || b == b'/'
+  }
+  let s = path.as_os_str().as_encoded_bytes();
+  s.len() >= 9
+    && is_sep(s[0])
+    && is_sep(s[1])
+    && (s[2] == b'.' || s[2] == b'?')
+    && is_sep(s[3])
+    && s[4..8].eq_ignore_ascii_case(b"pipe")
+    && is_sep(s[8])
+}
