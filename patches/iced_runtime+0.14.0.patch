+/// Requests a best-effort assistive-technology announcement for a window.
+///
+/// Completing this effect only means that the request reached the windowing
+/// runtime. It does not report whether assistive technology was active or
+/// whether the text was spoken.
+pub fn announce<T>(
+    id: Id,
+    text: impl Into<String>,
+    priority: AnnouncementPriority,
+) -> Task<T> {
+    task::effect(crate::Action::Window(Action::Announce(
+        id,
+        text.into(),
+        priority,
+    )))
+}
