+#[cfg(test)]
+mod tests {
+    use super::{Action, AnnouncementPriority, announce};
+    use crate::core::window::Id;
+    use crate::futures::futures::{FutureExt, StreamExt};
+
+    #[test]
+    fn announce_routes_the_exact_window_text_and_priority() {
+        let id = Id::unique();
+        let task = announce::<()>(
+            id,
+            "same localized text",
+            AnnouncementPriority::Assertive,
+        );
+        let mut stream = crate::task::into_stream(task)
+            .expect("announcement effect stream");
+        let action = stream
+            .next()
+            .now_or_never()
+            .flatten()
+            .expect("announcement action");
+
+        let crate::Action::Window(Action::Announce(
+            actual_id,
+            text,
+            AnnouncementPriority::Assertive,
+        )) = action
+        else {
+            panic!("expected assertive window announcement action");
+        };
+
+        assert_eq!(actual_id, id);
+        assert_eq!(text, "same localized text");
+    }
+}
